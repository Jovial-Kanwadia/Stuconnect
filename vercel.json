{
    "builds": [
        {
            "src": "Backend/Dockerfile",
            "use": "@vercel/docker"
        },
        {
            "src": "Frontend/Dockerfile",
            "use": "@vercel/docker"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "Backend/$1"
        },
        {
            "src": "/(.*)",
            "dest": "Frontend/$1"
        }
    ]
}